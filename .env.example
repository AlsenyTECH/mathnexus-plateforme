# Copier en .env et remplir. Ne jamais committer le fichier .env.

# Développement : 1 ; production : 0
DJANGO_DEBUG=1
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production, l'adresse publique, par exemple https://app.mathnexus.sn
DJANGO_CSRF_TRUSTED_ORIGINS=
# Derrière Caddy en local, sans HTTPS : 0
DJANGO_SSL_REDIRECT=0

POSTGRES_PASSWORD=

# Limites (facultatif)
LIMITE_CONNEXION=5/min
LIMITE_INSCRIPTION=10/hour
MAX_SESSIONS_PAR_COMPTE=2

# Empreinte SHA-256 de la clé du moteur de parcours (jamais la clé elle-même)
CLE_DEPLOIEMENT_SHA256=

# Domaine public servi par Caddy (HTTPS automatique), par exemple app.mathnexus.sn ; « :80 » en local
DOMAINE=:80
